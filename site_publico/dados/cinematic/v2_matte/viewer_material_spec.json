 "micro_detail": {
  "enabled": true,
  "type": "tiling tangent-space noise normal map (or triplanar in shader)",
  "normalScale": [
   0.08,
   0.08
  ],
  "feature_size_mm": 2.5,
  "note": "very low; only to break CG smoothness. Omit on iPad if GPU-bound."
 },
 "fake_sss_optional": {
  "method": "wrap lighting + thickness-based back-light (onBeforeCompile) or r18x MeshSSSNodeMaterial",
  "wrap": 0.25,
  "scatterColor": "#a0372a",
  "thicknessPower": 2.0,
  "thicknessScale": 4.0,
  "thicknessAmbient": 0.0,
  "note": "keep subtle; this is what gives tissue its soft light bleed at edges without any specular"
 },
 "lighting": {
  "environment": {
   "hdri": "Poly Haven photo_studio_loft_hall_1k.hdr (CC0) — low-contrast studio",
   "loader": "RGBELoader (r169)",
   "pmrem": "PMREMGenerator.fromEquirectangular",
   "scene.environment": true,
   "scene.background": "dark vertical gradient (#07080b -> #17191e), NOT the HDRI",
   "environmentIntensity_or_envMapIntensity": 0.45,
   "environmentRotationY_deg": 30
  },
  "key": {
   "type": "DirectionalLight",
   "intensity": 1.6,
   "color": "#fff7ee",
   "position": "camera-relative: up-left (~45° elevation)",
   "castShadow": true,
   "shadow": {
    "type": "PCFSoftShadowMap",
    "mapSize": 2048,
    "radius": 6,
    "bias": -0.0005,
    "normalBias": 0.6
   }
  },
  "fill": {
   "type": "HemisphereLight",
   "skyColor": "#f2f3f7",
   "groundColor": "#3a3635",
   "intensity": 0.6
  },
  "rim": {
   "type": "DirectionalLight",
   "intensity": 0.5,
   "color": "#f5f7ff",
   "position": "behind-above",
   "castShadow": false
  },
  "avoid": "PointLight/SpotLight close to the meshes and any RoomEnvironment with bright small emitters (they create hot specular spots)"
 },
 "tone_mapping": {
  "toneMapping": "AgXToneMapping",
  "toneMappingExposure": 0.9,
  "alternative": "NeutralToneMapping (Khronos PBR Neutral) when legend colours must match exactly; both are in r169",
  "avoid": "ACESFilmicToneMapping (shifts saturated reds to orange and adds contrast)"
 },
 "ambient_occlusion": {
  "preferred": "N8AO 2.0.1 (N8AOPass for three EffectComposer)",
  "aoRadius_mm": 10,
  "distanceFalloff": 1.0,
  "intensity": 2.5,
  "halfRes_on_iPad": true,
  "fallback": "GTAOPass (vendored) radius 10 mm, render transparent ghosts after AO"
 },
 "post": {
  "bloom": "off (or threshold >= 0.95, strength <= 0.05)",
  "SMAA": true,
  "DOF": "presentation only (BokehPass, focus on tumour centroid)"
 },
 "references": {
  "offline_matte_stills": "out/cinematic/v2_matte/blender/*.png",
  "volume_matte_stills": "out/cinematic/v2_matte/volume/*.png"
 }
}